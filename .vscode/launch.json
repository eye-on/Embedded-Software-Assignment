{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (ST-LINK + OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "build/app.elf",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "openOCDLaunchCommands": [
        "adapter speed 1000"
      ],
      "device": "STM32F407ZG",
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ]
}
